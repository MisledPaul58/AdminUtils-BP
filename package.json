{
  "name": "adminutils-bp",
  "version": "1.2.0",
  "description": "AdminUtils - a wide range of administration and moderation tools for Minecraft Bedrock worlds and servers.",
  "private": true,
  "license": "GPL-3.0-or-later",
  "author": "MisledPaul58",
  "scripts": {
    "clean": "node tools/clean.mjs",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "build": "npm run clean && node tools/build.mjs && node tools/inject-version.mjs",
    "watch": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint \"src/**/*.ts\"",
    "package": "npm run build && node tools/pack.mjs"
  },
  "dependencies": {
    "@minecraft/server": "^2.11.0-beta.1.26.51-stable",
    "@minecraft/server-ui": "^2.3.0-beta.1.26.51-stable"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@types/node": "^22.7.0",
    "archiver": "^8.0.0",
    "eslint": "^10.0.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
